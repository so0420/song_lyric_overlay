# Dev
ENVIRONMENT=local # local, staging, production

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# Naver Oauth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/api/v1/oauth/naver/callback
NAVER_WITHDRAW_URL=http://localhost:8000/api/v1/oauth/naver/callback/withdraw

# Youtube API Key
YOUTUBE_API_KEY=

# Log
LOG_FILE_PATH="app/logs/"

# JWT
JWT_SECRET_KEY="my_secret_key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL=1209600
JWT_REFRESH_TOKEN_TTL=1209600

# DB
DB_TYPE=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# OTP
OTP_TTL=600
OTP_MAX_ATTEMPTS=5

# Meilisearch
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_NAME=
